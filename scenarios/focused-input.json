{
  "name": "ordinary focused hold and vanilla hotbar synchronization",
  "about": "Run in a disposable flat world (structures disabled) with player Puppet and the existing server bridge. Uses ordinary survival input while real focus is false; supplies only finite test blocks/items. Tests different/already-selected/empty/clamped hotbar with independent server readback and unchanged inventory, vanilla wool mining/tool wear, normal slow incorrect-tool stone behavior, bow USE, movement and screen/parse refusal. No server selection write or fabricated slot packet. Concurrent stop/release/context cancellation and stale-cache reconnect require separate supervised API tests; this serial scenario does not claim them. Runs on 1.20.1 and 1.21.1.",
  "setup": [
    {"op":"stop"},
    {"op":"close_screen","optional":true},
    {"side":"server","op":"command","args":{"command":"difficulty peaceful"}},
    {"side":"server","op":"command","args":{"command":"gamemode survival Puppet"}},
    {"side":"server","op":"command","args":{"command":"clear Puppet"}},
    {"side":"server","op":"command","args":{"command":"fill -2 -60 -2 5 -56 5 minecraft:air"}},
    {"side":"server","op":"command","args":{"command":"tp Puppet 0.5 -60 0.5 0 0"}},
    {"side":"server","op":"command","args":{"command":"setblock 3 -60 0 minecraft:white_wool"}},
    {"side":"server","op":"command","args":{"command":"item replace entity Puppet hotbar.0 with minecraft:iron_axe 1"}},
    {"side":"server","op":"command","args":{"command":"item replace entity Puppet hotbar.1 with minecraft:cobblestone 1"}},
    {"side":"server","op":"command","args":{"command":"item replace entity Puppet hotbar.2 with minecraft:arrow 4"}},
    {"side":"server","op":"command","args":{"command":"item replace entity Puppet hotbar.3 with minecraft:bow 1"}},
    {"op":"wait_until","args":{"op":"count","args":{"item":"minecraft:iron_axe"},"equals":1,"timeout_ms":5000}},
    {"op":"window","args":{"focused":false},"expect":[{"path":"focused","equals":false}]}
  ],
  "steps": [
    {"side":"server","op":"inventory","args":{"player":"Puppet"},"save":"beforeSlots"},
    {"op":"hotbar","args":{"slot":1},"expect":[{"equals":null}]},
    {"side":"server","op":"command","args":{"command":"data get entity Puppet SelectedItemSlot"},"eventually":2000,"expect":[{"path":"output[0]","matches":": 1$"}]},
    {"op":"hotbar","args":{"slot":0}},
    {"op":"hotbar","args":{"slot":0},"note":"same desired slot still performs alternate+desired vanilla synchronization"},
    {"side":"server","op":"command","args":{"command":"data get entity Puppet SelectedItemSlot"},"eventually":2000,"expect":[{"path":"output[0]","matches":": 0$"}]},
    {"side":"server","op":"command","args":{"command":"data get entity Puppet SelectedItem"},"eventually":2000,"expect":[{"path":"output[0]","contains":"minecraft:iron_axe"}]},
    {"op":"hotbar","args":{"slot":99}},
    {"side":"server","op":"command","args":{"command":"data get entity Puppet SelectedItemSlot"},"eventually":2000,"expect":[{"path":"output[0]","matches":": 8$"}]},
    {"op":"hotbar","args":{"slot":-1}},
    {"side":"server","op":"command","args":{"command":"data get entity Puppet SelectedItemSlot"},"eventually":2000,"expect":[{"path":"output[0]","matches":": 0$"}]},
    {"side":"server","op":"inventory","args":{"player":"Puppet"},"expect":[{"equals":"${beforeSlots}"}]},
    {"op":"look","args":{"at":{"x":3.5,"y":-59.5,"z":0.5}},"expect":[{"path":"kind","equals":"block"},{"path":"block","equals":"minecraft:white_wool"}]},
    {"op":"hold","args":{"keys":["attack"],"ticks":45},"expect":[{"path":"on_ground","equals":true}]},
    {"side":"server","op":"block","args":{"x":3,"y":-60,"z":0},"eventually":2000,"expect":[{"path":"block","equals":"minecraft:air"}]},
    {"side":"server","op":"command","args":{"command":{"mc<1.20.5":"data get entity Puppet Inventory[{Slot:0b}].tag.Damage","else":"data get entity Puppet Inventory[{Slot:0b}].components.\"minecraft:damage\""}},"expect":[{"path":"output[0]","matches":": 1$"}]},
    {"op":"window","expect":[{"path":"focused","equals":false}]},
    {"side":"server","op":"command","args":{"command":"setblock 3 -60 0 minecraft:stone"}},
    {"op":"wait_until","args":{"op":"block","args":{"x":3,"y":-60,"z":0},"path":"block","equals":"minecraft:stone","timeout_ms":2000}},
    {"op":"look","args":{"at":{"x":3.5,"y":-59.5,"z":0.5}}},
    {"op":"hold","args":{"keys":["attack"],"ticks":8},"note":"iron axe retains vanilla slow stone progression; no forced success"},
    {"side":"server","op":"block","args":{"x":3,"y":-60,"z":0},"expect":[{"path":"block","equals":"minecraft:stone"}]},
    {"op":"hotbar","args":{"slot":3}},
    {"op":"look","args":{"yaw":0,"pitch":-20}},
    {"op":"hold","args":{"keys":["use"],"ticks":30}},
    {"op":"count","args":{"item":"minecraft:arrow"},"eventually":3000,"expect":[{"equals":3}]},
    {"op":"window","expect":[{"path":"focused","equals":false}]},
    {"op":"look","args":{"yaw":0,"pitch":0}},
    {"op":"player","save":"beforeWalk"},
    {"op":"hold","args":{"keys":["forward"],"ticks":10},"expect":[{"path":"pos.z","gt":"${beforeWalk.pos.z}"}]},
    {"op":"hold","args":{"keys":["use","no.such.binding.input.regression"],"ticks":2},"expect_error":"no key binding"},
    {"op":"window","expect":[{"path":"focused","equals":false}]},
    {"op":"key","args":{"key":"e"}},
    {"op":"wait","args":{"for":"screen"}},
    {"op":"hold","args":{"keys":["attack"],"ticks":10},"expect_error":"a screen is open"},
    {"op":"hotbar","args":{"slot":0},"expect_error":"a screen is open"},
    {"op":"close_screen"},
    {"op":"stop"},
    {"op":"window","expect":[{"path":"focused","equals":false}]}
  ],
  "teardown": [
    {"op":"stop"},
    {"op":"close_screen","optional":true},
    {"side":"server","op":"command","args":{"command":"setblock 3 -60 0 minecraft:air"}},
    {"side":"server","op":"command","args":{"command":"kill @e[type=minecraft:arrow]"}},
    {"side":"server","op":"command","args":{"command":"clear Puppet"}},
    {"op":"window","args":{"focused":true}}
  ]
}
