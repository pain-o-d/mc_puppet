{
  "name": "see without a screenshot, and move as a player moves",
  "about": "Run in a flat world with the player called Puppet. Walks, breaks a block by hand, hits a pig, and reads a tooltip, the action bar, a sound and a frame as data. Leaves the world as it found it. Runs on 1.20.1 and 1.21.1: the enchanted sword is given in each version's own words.",
  "setup": [
    {"op":"stop"},
    {"op":"close_screen","optional":true},
    {"side":"server","op":"command","args":{"command":"difficulty peaceful"}},
    {"side":"server","op":"command","args":{"command":"gamemode survival Puppet"}},
    {"side":"server","op":"command","args":{"command":"kill @e[type=!minecraft:player,distance=..24]","as":"Puppet"}},
    {"side":"server","op":"command","args":{"command":"clear Puppet"}},
    {"side":"server","op":"command","args":{"command":"fill -2 -60 -2 8 -58 8 minecraft:air"}},
    {"side":"server","op":"command","args":{"command":"tp Puppet 0.5 -60 0.5 0 0"}},
    {"side":"server","op":"command","args":{"command":"setblock 3 -60 0 minecraft:dirt"}},
    {"side":"server","op":"command","args":{"command":{"mc<1.20.5":"give Puppet minecraft:diamond_sword{Enchantments:[{id:\"minecraft:sharpness\",lvl:3s}]} 1","else":"give Puppet minecraft:diamond_sword[enchantments={levels:{'minecraft:sharpness':3}}] 1"}}},
    {"op":"wait_until","args":{"op":"count","args":{"item":"minecraft:diamond_sword"},"equals":1,"timeout_ms":5000}},
    {"op":"wait_until","note":"the client has heard about the block","args":{"op":"block","args":{"x":3,"y":-60,"z":0},"path":"block","equals":"minecraft:dirt","timeout_ms":5000}}
  ],
  "steps": [
    {"op":"move_to","args":{"x":0.5,"z":5.5},"note":"walking is the forward key held down","expect":[{"path":"off_by","lte":0.6},{"path":"on_ground","equals":true}]},
    {"side":"server","op":"players","note":"and the server saw the player walk there","eventually":2000,"expect":[{"path":"[name=Puppet].pos.z","gt":4.5},{"path":"[name=Puppet].pos.z","lt":6.5}]},
    {"op":"move_to","args":{"x":1.5,"z":0.5,"within":0.4}},
    {"op":"hotbar","args":{"slot":8},"note":"an empty hand, so that the time it takes is a hand's"},
    {"op":"look","args":{"at":{"x":3.5,"y":-59.5,"z":0.5}},"expect":[{"path":"kind","equals":"block"},{"path":"block","equals":"minecraft:dirt"}]},
    {"op":"break_block","args":{"x":3,"y":-60,"z":0},"note":"dirt by hand is three quarters of a second","expect":[{"path":"broke","equals":"minecraft:dirt"},{"path":"ticks","gte":10},{"path":"ticks","lte":25}]},
    {"side":"server","op":"block","args":{"x":3,"y":-60,"z":0},"eventually":2000,"expect":[{"path":"block","equals":"minecraft:air"}]},
    {"side":"server","op":"command","args":{"command":"summon minecraft:pig 0.5 -60 3.0 {NoAI:1b}"}},
    {"op":"move_to","args":{"x":0.5,"z":0.5,"within":0.4}},
    {"op":"wait_until","args":{"op":"entities","args":{"type":"minecraft:pig"},"path":"[0].health","equals":10,"timeout_ms":5000}},
    {"op":"events","args":{"limit":1},"save":"before_hit"},
    {"op":"attack","args":{"type":"minecraft:pig"},"save":"hit","note":"a fist: the game's own attack on what the crosshair is on","expect":[{"path":"target.kind","equals":"entity"},{"path":"target.entity.type","equals":"minecraft:pig"}]},
    {"side":"server","op":"entity","args":{"uuid":"${hit.target.entity.uuid}"},"eventually":3000,"note":"that pig and no other: a world has pigs of its own, which the first NeoForge run met","expect":[{"path":"health","equals":9}]},
    {"op":"events","note":"and it was heard","args":{"since":"${before_hit.sequence}","kinds":"sound","contains":"entity.player.attack"},"eventually":3000,"expect":[{"path":"events#","gte":1}]},
    {"op":"key","args":{"key":"e"}},
    {"op":"wait","args":{"for":"screen","value":"minecraft:player_inventory","timeout_ms":3000}},
    {"op":"screen","save":"inventory"},
    {"op":"tooltip","args":{"slot":"${inventory.slots[stack.id~=diamond_sword].slot}"},"note":"a tooltip as lines, with what enchantments add","expect":[{"path":"lines[0]","equals":"Diamond Sword"},{"path":"lines","contains":"Sharpness III"}]},
    {"op":"frame","show":"issues","note":"what the screen draws without widgets, and nothing wrong with where. Before the action bar below: the HUD is drawn behind a screen, and vanilla itself draws the action bar over the held item's name","expect":[{"path":"texts[text=Crafting]","exists":true},{"path":"items[id=minecraft:diamond_sword]","exists":true},{"path":"issues#","equals":0}]},
    {"op":"key","args":{"key":"escape"}},
    {"op":"wait","args":{"for":"no_screen","timeout_ms":3000}},
    {"op":"events","args":{"limit":1},"save":"before_bar"},
    {"side":"server","op":"command","args":{"command":"title Puppet actionbar {\"text\":\"Sold for 47 cents\"}"}},
    {"op":"wait_until","args":{"op":"hud","path":"actionbar","equals":"Sold for 47 cents","timeout_ms":3000}},
    {"op":"events","args":{"since":"${before_bar.sequence}","kinds":"actionbar"},"expect":[{"path":"events[0].text","equals":"Sold for 47 cents"}]},
    {"op":"frame","args":{"contains":"47 cents"},"note":"and it is on screen, inside it","expect":[{"path":"texts#","gte":1},{"path":"texts[0].x","gte":0}]},
    {"op":"hotbar","args":{"slot":0}},
    {"op":"tap","args":{"key":"drop"},"note":"whatever key drop is bound to"},
    {"op":"wait_until","args":{"op":"count","args":{"item":"minecraft:diamond_sword"},"equals":0,"timeout_ms":3000}}
  ],
  "teardown": [
    {"op":"stop"},
    {"op":"close_screen","optional":true},
    {"side":"server","op":"command","args":{"command":"kill @e[type=!minecraft:player,distance=..24]","as":"Puppet"}},
    {"side":"server","op":"command","args":{"command":"clear Puppet"}},
    {"side":"server","op":"command","args":{"command":"gamemode creative Puppet"}},
    {"side":"server","op":"command","args":{"command":"tp Puppet 0.5 -60 0.5 0 0"}}
  ]
}
