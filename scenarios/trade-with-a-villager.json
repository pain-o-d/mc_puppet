{
  "name": "buy apples from a farmer, and have both sides of the game agree about it",
  "about": "Run in a creative flat world with the player called Puppet standing still. Summons its own farmer and cleans up after itself.",
  "steps": [
    { "side": "server", "op": "command", "note": "a clean slate",
      "args": { "command": "kill @e[type=minecraft:villager,distance=..8]", "as": "Puppet" } },
    { "side": "server", "op": "command", "args": { "command": "clear Puppet" } },
    { "side": "server", "op": "command", "note": "a farmer that stays put",
      "args": { "as": "Puppet",
                "command": "summon minecraft:villager ~ ~ ~ {VillagerData:{profession:\"minecraft:farmer\",level:2,type:\"minecraft:plains\"},NoAI:1b,Offers:{Recipes:[{buy:{id:\"minecraft:emerald\",count:1},sell:{id:\"minecraft:apple\",count:4},maxUses:16}]}}" },
      "expect": [ { "path": "success", "equals": true } ] },
    { "side": "server", "op": "command", "args": { "command": "give Puppet minecraft:emerald 5" } },
    { "side": "server", "op": "wait", "args": { "ticks": 10 } },

    { "op": "count", "args": { "item": "minecraft:emerald" }, "note": "the client has heard about the emeralds",
      "expect": [ { "equals": 5 } ] },
    { "op": "use_entity", "args": { "type": "minecraft:villager" },
      "expect": [ { "path": "profession", "equals": "minecraft:farmer" } ] },
    { "op": "wait", "args": { "for": "screen", "value": "Merchant", "timeout_ms": 10000 } },

    { "op": "screen", "save": "opened",
      "expect": [ { "path": "title", "equals": "Farmer" },
                  { "path": "offers#", "equals": 1 },
                  { "path": "offers[0].sell", "equals": { "id": "minecraft:apple", "count": 4 } },
                  { "path": "offers[0].uses", "equals": 0 },
                  { "path": "panel.w", "equals": 276 } ] },

    { "op": "select_trade", "args": { "index": 0 }, "note": "clicking the offer fills the payment slot" },
    { "op": "wait", "args": { "for": "ticks", "value": 5 } },
    { "op": "screen",
      "expect": [ { "path": "slots[slot=0].stack.id", "equals": "minecraft:emerald" },
                  { "path": "slots[slot=2].stack", "equals": { "id": "minecraft:apple", "count": 4 } } ] },

    { "op": "click_slot", "args": { "slot": 2, "action": "QUICK_MOVE" }, "note": "shift-click the result: buys until the emeralds run out" },
    { "op": "wait", "args": { "for": "ticks", "value": 10 } },

    { "op": "count", "args": { "item": "minecraft:apple" }, "expect": [ { "equals": 20 } ] },
    { "op": "screen", "expect": [ { "path": "offers[0].uses", "equals": 5 } ] },
    { "op": "screenshot", "args": { "name": "trade-with-a-villager" }, "show": "path" },
    { "op": "close_screen" },
    { "op": "wait", "args": { "for": "no_screen", "timeout_ms": 5000 } },

    { "side": "server", "op": "count", "args": { "player": "Puppet", "item": "minecraft:apple" },
      "note": "and the server agrees", "expect": [ { "equals": 20 } ] },
    { "side": "server", "op": "count", "args": { "player": "Puppet", "item": "minecraft:emerald" },
      "expect": [ { "equals": 0 } ] },
    { "side": "server", "op": "entities", "args": { "type": "minecraft:villager", "offers": true },
      "expect": [ { "path": "entities[0].offers[0].uses", "equals": 5 } ] },

    { "side": "server", "op": "command", "args": { "command": "kill @e[type=minecraft:villager,distance=..8]", "as": "Puppet" } },
    { "side": "server", "op": "command", "args": { "command": "clear Puppet" } }
  ]
}
